# Backend (se lee desde la raíz del repo). Copiar como .env y completar.
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
# Clave secreta del proyecto (Settings > API Keys > Secret). Nunca la del frontend.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# JWT: mínimo 32 caracteres. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=180

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
